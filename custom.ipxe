#!ipxe
###
### made by Efebey007
###

:custom
clear choice
menu WindowsNetboot
item --gap Windows PEs
item option_one ${space} Boot into AOMEI Partition Assistant PE
item option_one ${space} Boot into Windows Netboot PE
item --gap Other Custom PEs (not ready yet.)
choose choice || goto exit
echo ${cls}
goto ${choice}
goto exit

:option_one
imgfree
kernel http://boot.netboot.xyz/wimboot
initrd -n bootmgr  https://github.com/Efebey007/netboot.xyz-custom/raw/refs/heads/main/bootfiles/bootmgr      bootmgr ||
initrd -n bootmgr.efi  https://github.com/Efebey007/netboot.xyz-custom/raw/refs/heads/main/bootfiles/bootmgr.efi   bootmgr.efi ||   
initrd -n bootmgfw.efi https://github.com/Efebey007/netboot.xyz-custom/raw/refs/heads/main/bootfiles/bootmgfw.efi bootmgfw.efi ||
initrd -n bcd  https://github.com/Efebey007/netboot.xyz-custom/raw/refs/heads/main/bootfiles/bcd      bcd ||
initrd -n boot.sdi  https://github.com/Efebey007/netboot.xyz-custom/raw/refs/heads/main/bootfiles/boot.sdi boot.sdi || 
initrd -n boot.wim  http://161.97.166.249/win-recovery/x64/sources/boot.wim boot.wim
boot || goto exit

:option_two
imgfree
kernel http://boot.netboot.xyz/wimboot
initrd -n bootmgr  https://github.com/Efebey007/netboot.xyz-custom/raw/refs/heads/main/bootfiles/bootmgr      bootmgr ||
initrd -n bootmgr.efi  https://github.com/Efebey007/netboot.xyz-custom/raw/refs/heads/main/bootfiles/bootmgr.efi   bootmgr.efi ||   
initrd -n bootmgfw.efi https://github.com/Efebey007/netboot.xyz-custom/raw/refs/heads/main/bootfiles/bootmgfw.efi bootmgfw.efi ||
initrd -n bcd  https://github.com/Efebey007/netboot.xyz-custom/raw/refs/heads/main/bootfiles/bcd      bcd ||
initrd -n boot.sdi  https://github.com/Efebey007/netboot.xyz-custom/raw/refs/heads/main/bootfiles/boot.sdi boot.sdi || 
initrd -n boot.wim  https://github.com/Efebey007/netboot.xyz-custom/releases/download/windowsnetboot/boot.wim boot.wim
boot || goto exit

:exit
chain http://boot.netboot.xyz/ipxe/netboot.xyz.efi
exit
