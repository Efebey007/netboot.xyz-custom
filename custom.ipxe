#!ipxe
###
### made by Efebey007
###

:custom
clear choice
menu WindowsNetboot
item --gap Windows PEs
item option_one ${space} Boot into AOMEI Partition Assistant PE
item option_one ${space} Boot into Windows Netboot PE
item --gap Other Custom PEs (not ready yet.)
choose choice || goto exit
echo ${cls}
goto ${choice}
goto exit

:option_one
imgfree
kernel http://boot.netboot.xyz/wimboot
initrd -n bootmgr  http://161.97.166.249/win-recovery/x64/bootmgr       bootmgr ||
initrd -n bootmgr.efi  http://161.97.166.249/win-recovery/x64/bootmgr.efi   bootmgr.efi ||   
initrd -n bootmgfw.efi https://github.com/rtedpro-cpu/windowsnetboot/raw/refs/heads/main/betatest/bootmgfw.efi bootmgfw.efi ||
initrd -n bcd  http://161.97.166.249/win-recovery/x64/boot/BCD      bcd ||
initrd -n boot.sdi  http://161.97.166.249/win-recovery/x64/boot/boot.sdi boot.sdi || 
initrd -n boot.wim  http://161.97.166.249/win-recovery/x64/sources/boot.wim boot.wim
boot || goto exit

:option_two
imgfree
kernel http://boot.netboot.xyz/wimboot
initrd -n bootmgr  <add link>      bootmgr ||
initrd -n bootmgr.efi  <add link>   bootmgr.efi ||   
initrd -n bootmgfw.efi <add link> bootmgfw.efi ||
initrd -n bcd  <add link>      bcd ||
initrd -n boot.sdi  <add link> boot.sdi || 
initrd -n boot.wim  <add link> boot.wim
boot || goto exit

:exit
chain http://boot.netboot.xyz/ipxe/netboot.xyz.efi
exit
