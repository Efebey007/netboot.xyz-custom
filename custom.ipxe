#!ipxe
###
### made by rtedpro-cpu
### collaborator Efebey007
###

:custom
clear choice
menu WindowsNetboot
item --gap Windows PEs
item option_one ${space} Boot into AOMEI Partition Assistant PE
item option_one ${space} Boot into Anhdv's Boot PE
item --gap Other Custom PEs (not ready yet.)
choose choice || goto exit
echo ${cls}
goto ${choice}
goto exit

:option_one
imgfree
kernel http://boot.netboot.xyz/wimboot
initrd -n bootmgr     https://micro.cruizernw.com.tr/win-recovery/x64/bootmgr       bootmgr ||
initrd -n bootmgr.efi https://micro.cruizernw.com.tr/win-recovery/x64/bootmgr.efi   bootmgr.efi ||      
initrd -n bcd         https://micro.cruizernw.com.tr/win-recovery/x64/boot/BCD      bcd ||
initrd -n boot.sdi    https://micro.cruizernw.com.tr/win-recovery/x64/boot/boot.sdi boot.sdi ||
initrd -n boot.wim    https://micro.cruizernw.com.tr/win-recovery/x64/sources/boot.wim boot.wim
boot || goto exit

:option_two
imgfree
kernel http://boot.netboot.xyz/wimboot
initrd -n bootmgr     https://github.com/rtedpro-cpu/windowsnetboot/raw/refs/heads/main/release/hbcd/BOOTMGR       bootmgr ||
initrd -n bootmgr.efi https://github.com/rtedpro-cpu/windowsnetboot/raw/refs/heads/main/release/hbcd/bootmgr.efi   bootmgr.efi || 
initrd -n bootmgfw.efi https://github.com/rtedpro-cpu/windowsnetboot/raw/refs/heads/main/betatest/bootmgfw.efi   bootmgfw.efi || 
initrd -n bcd         https://github.com/rtedpro-cpu/windowsnetboot/raw/refs/heads/main/release/hbcd/boot/bcd      bcd ||
initrd -n boot.sdi    https://github.com/rtedpro-cpu/windowsnetboot/raw/refs/heads/main/release/hbcd/boot/boot.sdi boot.sdi ||
initrd -n boot.wim    https://github.com/rtedpro-cpu/windowsnetboot/releases/download/hbcd/boot.wim boot.wim
boot || goto exit

:option_beta
kernel https://boot.netboot.xyz/memdisk raw iso
initrd "https://github.com/Efebey2903/files/releases/download/WinNTSetup%26%26AOMEI/PartAssist_WinPE.iso"
boot || goto exit

:exit
chain utils.ipxe
exit
